# Optional. Links are created on the token admin page now; this one is only
# for a link you sent before that page existed. It cannot be revoked without a
# restart, which is the whole reason the page exists.
CHAT_BOT_TOKEN=
CHAT_BOT_SECRET=replace-me-openssl-rand-hex-32
CHAT_SESSION_TTL=43200

# The token admin page. Its own listener on 127.0.0.1 — never behind HAProxy,
# never in the tunnel. http://127.0.0.1:3001
ADMIN_ENABLED=true
ADMIN_PORT=3001
TOKEN_STORE_PATH=./data/tokens.json
# Only used to build the link the page shows after a token is created.
PUBLIC_SITE_URL=http://127.0.0.1:8080

LB_PORT=8080
LB_STATS_PORT=5000

LB_SITE_RATE=300
LB_API_RATE=20
LB_API_ERR_RATE=20
CHAT_API_PORT=3000

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hire-jose

MAX_REQUEST_LENGTH=4000
MAX_ANSWER_SENTENCES=4

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# The theme switch the assistant can run. Leave GITHUB_TOKEN empty and the
# switch is off: it tells the visitor it is not wired up here and pushes
# nothing. A fine-grained token with contents:write on this one repo turns it
# on. ARGOCD_* is only what the answer shows the visitor.
GITHUB_TOKEN=
GITHUB_REPO=jnaranj09/hire-jose
GITHUB_BRANCH=main
THEME_MANIFEST_PATH=k8s/20-chat-api.yaml
THEME_COOLDOWN=60

ARGOCD_URL=
ARGOCD_USERNAME=viewer
ARGOCD_PASSWORD=
